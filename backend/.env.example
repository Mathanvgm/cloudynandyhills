SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=property-images
SUPABASE_TABLE=properties
PORT=3000
ALLOWED_ORIGIN=https://mnccoimbatore.in

# CCAvenue
CCAVENUE_MERCHANT_ID=your-merchant-id
CCAVENUE_ACCESS_CODE=your-access-code
CCAVENUE_WORKING_KEY=your-working-key
CCAVENUE_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction

# These must match your live domain
BACKEND_URL=https://mnccoimbatore.in
FRONTEND_URL=https://mnccoimbatore.in

# SkyHMS Integration Configuration
# Set to 'false' in production when live API credentials are provisioned
SKYHMS_USE_MOCK=true
SKYHMS_SYNC_ENABLED=true
SKYHMS_DRY_RUN=false
SKYHMS_API_URL=https://api.skyhms.in/v1
SKYHMS_API_KEY=your-skyhms-api-key
SKYHMS_HOTEL_CODE=CLOUDNANDY_KODAI
SKYHMS_PROPERTY_ID=CNH-01
SKYHMS_TIMEOUT_MS=15000
SKYHMS_WEBHOOK_SECRET=your-skyhms-webhook-secret
SKYHMS_SYNC_INTERVAL_MINUTES=15
SKYHMS_MAX_RETRIES=5
